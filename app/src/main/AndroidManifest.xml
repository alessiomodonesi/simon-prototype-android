<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Simon">

        <!-- MainActivity (1a schermata)
        android:exported="false" => essendo un intent esplicito quello che parte da MainActivity
        non c'è bisogno che il sistema o altre app "vedano" questa activity all'esterno -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Simon" />

        <!-- HistoryActivity (2a schermata)
        nella versione finale dell'app, questa schermata diventa la principale -->
        <activity
            android:name=".HistoryActivity"
            android:exported="true"
            android:theme="@style/Theme.Simon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DetailActivity (3a schermata)
            android:exported="false" => essendo un intent esplicito quello che parte da MainActivity
            non c'è bisogno che il sistema o altre app "vedano" questa activity all'esterno -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Simon" />
    </application>
</manifest>